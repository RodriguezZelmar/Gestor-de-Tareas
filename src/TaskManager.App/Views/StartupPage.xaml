<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             x:Class="TaskManager.App.Views.StartupPage"
             x:DataType="vm:StartupViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
        <Label Text="Gestor de Tareas" Style="{StaticResource H1}" HorizontalOptions="Center" />
        <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
        <Label Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
