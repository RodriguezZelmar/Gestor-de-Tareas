<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TaskManager.App.ViewModels"
             x:Class="TaskManager.App.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Crear cuenta"
             Shell.FlyoutBehavior="Disabled">
    <ScrollView>
        <Grid Padding="20" RowDefinitions="*,Auto,*">
            <Border Grid.Row="1" Style="{StaticResource Card}" MaximumWidthRequest="420" Padding="28">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Crear cuenta" Style="{StaticResource H1}" />
                    <Label Text="Tus datos se guardan cifrados sólo en este dispositivo." Style="{StaticResource Muted}" Margin="0,0,0,8" />

                    <Label Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" MaxLength="80" Placeholder="Tu nombre" />

                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Email}" Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="254" Placeholder="vos@ejemplo.com" />

                    <Label Text="Contraseña" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Password}" IsPassword="True" MaxLength="128" />
                    <Label Text="Mínimo 8 caracteres, con letras y números." Style="{StaticResource Muted}" FontSize="12" />

                    <Label Text="Repetir contraseña" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" MaxLength="128" ReturnType="Go" ReturnCommand="{Binding RegisterCommand}" />

                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" Margin="0,6,0,0" />

                    <Button Text="Crear cuenta" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,16,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
                    <Button Text="Ya tengo cuenta" Style="{StaticResource TextButton}" Command="{Binding BackCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
